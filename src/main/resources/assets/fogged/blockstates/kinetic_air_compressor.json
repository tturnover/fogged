      "when": {
        "facing": "north|south|down|up",
        "axis": "x",
        "negative": "false"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_side_west"
      }
    },
    {
      "when": {
        "facing": "north|south|down|up",
        "axis": "y|z"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_side_west"
