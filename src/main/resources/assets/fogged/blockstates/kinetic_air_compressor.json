        "positive": "true"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_socket_up"
      }
    },
    {
      "when": {
        "facing": "north|south|west|east",
        "axis": "y",
        "positive": "false"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_side_up"
      }
    },
    {
      "when": {
        "facing": "north|south|west|east",
        "axis": "x|z"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_side_up"
      }
    }
