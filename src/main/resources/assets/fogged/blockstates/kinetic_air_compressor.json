{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_base"
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_base",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_base",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_base",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "up"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_base",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "down"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_base",
        "x": 90
      }
