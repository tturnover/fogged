    {
      "when": {
        "facing": "north|south|down|up",
        "axis": "y|z"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_side_east"
      }
    },
    {
      "when": {
        "facing": "north|south|west|east",
        "axis": "y",
        "negative": "true"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_socket_down"
