      }
    },
    {
      "when": {
        "facing": "west|east|down|up",
        "axis": "z",
        "negative": "false"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_side_north"
      }
    },
    {
      "when": {
        "facing": "west|east|down|up",
        "axis": "x|y"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_side_north"
      }
    },
    {
      "when": {
        "facing": "west|east|down|up",
        "axis": "z",
        "positive": "true"
      },
      "apply": {
        "model": "fogged:block/kinetic_air_compressor_socket_south"
