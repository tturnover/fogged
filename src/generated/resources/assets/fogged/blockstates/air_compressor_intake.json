{
  "multipart": [
    {
      "apply": {
        "model": "fogged:block/air_intake/vertical"
      },
      "when": {
        "facing": "down"
      }
    },
    {
      "apply": {
        "model": "fogged:block/air_intake/vertical",
        "x": 180
      },
      "when": {
        "facing": "up"
      }
    },
    {
      "apply": {
        "model": "fogged:block/air_intake/horizontal",
        "y": 180
      },
      "when": {
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "fogged:block/air_intake/horizontal"
      },
      "when": {
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "fogged:block/air_intake/horizontal",
        "y": 90
      },
      "when": {
        "facing": "west"
      }
    },
    {
      "apply": {
        "model": "fogged:block/air_intake/horizontal",
        "y": 270
      },
      "when": {
        "facing": "east"
      }
    }
  ]
}